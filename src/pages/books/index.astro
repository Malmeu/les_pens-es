---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Header } from '../../components/Header';

let books: any[] = [];
try {
	const chapters = await getCollection('books');
	if (chapters && chapters.length > 0) {
		const map = new Map<string, { bookId: string; bookTitle: string; bookDescription: string; coverColor: string; chaptersCount: number; date: any }>();
		
		chapters.forEach(ch => {
			if (!map.has(ch.data.bookId)) {
				map.set(ch.data.bookId, {
					bookId: ch.data.bookId,
					bookTitle: ch.data.bookTitle,
					bookDescription: ch.data.bookDescription || '',
					coverColor: ch.data.coverColor || 'pink',
					chaptersCount: 0,
					date: ch.data.date
				});
			}
			const data = map.get(ch.data.bookId)!;
			data.chaptersCount += 1;
			if (new Date(ch.data.date) > new Date(data.date)) {
				data.date = ch.data.date;
			}
		});
		
		books = Array.from(map.values()).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
	}
} catch (e) {
	console.log("Erreur lors de la lecture des livres dans index.astro :", e);
}

// Couleurs hex pour l'affichage statique CSS
const coverGradients = {
	pink: 'linear-gradient(135deg, #ffb7b2 0%, #ffc6ff 100%)',
	purple: 'linear-gradient(135deg, #c7ceea 0%, #e2b4f8 100%)',
	blue: 'linear-gradient(135deg, #b3d4f0 0%, #a2d2ff 100%)',
	green: 'linear-gradient(135deg, #b5ead7 0%, #c7f9cc 100%)',
	cream: 'linear-gradient(135deg, #fdfaf3 0%, #f5efe6 100%)'
};

const coverTextColors = {
	pink: '#6b4e71',
	purple: '#3f37c9',
	blue: '#023047',
	green: '#1b4332',
	cream: '#4a3f35'
};
---

<Layout title="Bibliothèque de Mina | Les Pensées de Mina">
	<Header client:load />
	
	<main class="library-page">
		<div class="container section-padding">
			<div class="library-header animate-fade-in">
				<span class="subtitle">Recueil d'histoires</span>
				<h1>La Bibliothèque de <span class="text-gradient">Mina</span></h1>
				<p>
					Parcourez mes récits, mes carnets intimes et mes romans poétiques. Prenez un livre sur l'étagère et tournez les pages au gré de vos envies.
				</p>
			</div>
			
			<div class="library-shelf-container">
				{books.length === 0 ? (
					<div class="empty-library glass animate-fade-in">
						<span class="empty-icon">📚</span>
						<h3>L'étagère est vide...</h3>
						<p>Mina n'a pas encore publié de livres. Si vous êtes l'auteure, commencez à écrire votre premier ouvrage dès maintenant !</p>
						<a href="/write" class="write-btn-cta">Écrire un livre</a>
					</div>
				) : (
					<div class="books-shelf-grid">
						{books.map((book) => {
							const gradient = coverGradients[book.coverColor as keyof typeof coverGradients] || coverGradients.pink;
							const textColor = coverTextColors[book.coverColor as keyof typeof coverTextColors] || coverTextColors.pink;
							
							return (
								<a href={`/books/${book.bookId}`} class="book-card-link">
									<div class="book-card-3d-wrapper">
										<div class="book-card-3d" style={`background: ${gradient}; color: ${textColor};`}>
											<div class="book-spine-effect"></div>
											<div class="book-cover-design">
												<div class="gold-line-frame">
													<span class="book-emblem">🌸</span>
													<h3 class="book-title">{book.bookTitle}</h3>
													<p class="book-author">Mina</p>
												</div>
											</div>
										</div>
										<div class="book-shadow"></div>
									</div>
									<div class="book-meta-info">
										<h4>{book.bookTitle}</h4>
										<p class="book-desc">{book.bookDescription || "Aucun résumé pour le moment."}</p>
										<span class="pages-count">{book.chaptersCount} page{book.chaptersCount > 1 ? 's' : ''}</span>
									</div>
								</a>
							);
						})}
					</div>
				)}
				{/* Étagère en verre décorative sous les livres */}
				{books.length > 0 && <div class="glass-shelf"></div>}
			</div>
		</div>
	</main>
</Layout>

<style>
	.library-page {
		min-height: 100vh;
		background: linear-gradient(to bottom, var(--bg), #fff);
	}

	.library-header {
		text-align: center;
		max-width: 700px;
		margin: 0 auto 5rem;
	}

	.library-header h1 {
		font-size: 3.5rem;
		margin-bottom: 1.5rem;
	}

	.library-header p {
		color: var(--text-light);
		font-size: 1.15rem;
		line-height: 1.8;
	}

	.subtitle {
		display: block;
		font-family: var(--font-script);
		font-size: 1.8rem;
		color: var(--secondary);
		margin-bottom: 0.5rem;
	}

	.library-shelf-container {
		position: relative;
		padding-bottom: 5rem;
	}

	/* Empty state */
	.empty-library {
		max-width: 600px;
		margin: 0 auto;
		text-align: center;
		padding: 4rem 2rem;
		border-radius: 24px;
	}

	.empty-icon {
		font-size: 4rem;
		display: block;
		margin-bottom: 1.5rem;
	}

	.empty-library h3 {
		font-size: 1.8rem;
		margin-bottom: 1rem;
		color: var(--text-dark);
	}

	.empty-library p {
		color: var(--text-light);
		font-size: 1.05rem;
		margin-bottom: 2rem;
		line-height: 1.6;
	}

	.write-btn-cta {
		display: inline-block;
		background: var(--primary);
		color: white;
		padding: 0.8rem 2.5rem;
		border-radius: 50px;
		font-weight: 600;
		box-shadow: 0 4px 15px rgba(126, 182, 226, 0.3);
		transition: all 0.3s ease;
	}

	.write-btn-cta:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(126, 182, 226, 0.4);
		background: #6a9fd1;
	}

	/* Books shelf grid */
	.books-shelf-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 4rem 2.5rem;
		padding: 0 1rem;
		justify-items: center;
		position: relative;
		z-index: 2;
	}

	.book-card-link {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		width: 100%;
		max-width: 240px;
	}

	/* 3D Book Cover Card */
	.book-card-3d-wrapper {
		position: relative;
		width: 160px;
		height: 230px;
		perspective: 1000px;
		margin-bottom: 2rem;
		transition: transform 0.4s ease;
	}

	.book-card-3d {
		width: 100%;
		height: 100%;
		border-radius: 4px 12px 12px 4px;
		box-shadow: inset 3px 0 10px rgba(0,0,0,0.1), 5px 5px 15px rgba(0,0,0,0.08);
		position: relative;
		transform-style: preserve-3d;
		transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
		overflow: hidden;
		border: 1px solid rgba(0,0,0,0.05);
	}

	.book-spine-effect {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 12px;
		background: linear-gradient(to right, rgba(0,0,0,0.15), rgba(255,255,255,0.1) 60%, rgba(0,0,0,0.05) 100%);
		border-right: 1px solid rgba(0,0,0,0.08);
		z-index: 3;
	}

	.book-cover-design {
		padding: 1.5rem;
		height: 100%;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: inset 0 0 25px rgba(0,0,0,0.05);
	}

	.gold-line-frame {
		border: 1.5px double rgba(255,255,255,0.5);
		border-radius: 8px;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 1rem 0.5rem;
		background: rgba(255,255,255,0.08);
	}

	.book-emblem {
		font-size: 1.8rem;
		margin-bottom: 1rem;
	}

	.book-title {
		font-family: var(--font-serif);
		font-size: 1.2rem;
		line-height: 1.3;
		margin-bottom: 1rem;
		font-weight: 700;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.book-author {
		font-family: var(--font-script);
		font-size: 1.5rem;
		margin-top: auto;
	}

	.book-shadow {
		position: absolute;
		bottom: -10px;
		left: 5%;
		width: 90%;
		height: 15px;
		background: rgba(0,0,0,0.1);
		filter: blur(8px);
		border-radius: 50%;
		z-index: -1;
		transition: transform 0.4s ease, opacity 0.4s ease;
	}

	/* 3D Hover Animations */
	.book-card-link:hover .book-card-3d {
		transform: rotateY(-22deg) translateZ(10px);
		box-shadow: inset 3px 0 10px rgba(0,0,0,0.05), 15px 15px 25px rgba(0,0,0,0.15);
	}

	.book-card-link:hover .book-shadow {
		transform: scale(1.1);
		opacity: 0.8;
	}

	.book-card-link:hover {
		transform: translateY(-5px);
	}

	/* Meta info below book */
	.book-meta-info {
		margin-top: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.book-meta-info h4 {
		font-family: var(--font-serif);
		font-size: 1.2rem;
		color: var(--text-dark);
		font-weight: 700;
	}

	.book-desc {
		font-size: 0.85rem;
		color: var(--text-light);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		max-height: 2.8em;
		line-height: 1.4;
	}

	.pages-count {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--primary);
		text-transform: uppercase;
		letter-spacing: 0.5px;
		margin-top: 0.2rem;
	}

	/* Etagere en verre */
	.glass-shelf {
		position: absolute;
		bottom: 120px;
		left: 0;
		width: 100%;
		height: 15px;
		background: rgba(255, 255, 255, 0.4);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255,255,255,0.25);
		border-radius: 5px;
		box-shadow: 0 15px 25px rgba(126, 182, 226, 0.1), inset 0 2px 2px rgba(255,255,255,0.5);
		z-index: 1;
	}

	@media (max-width: 576px) {
		.books-shelf-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
		.glass-shelf {
			display: none;
		}
	}
</style>
