---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import { Editor } from '../components/Editor';

const thoughts = await getCollection('thoughts');
const sortedThoughts = thoughts.map(t => ({
	id: t.id,
	title: t.data.title,
	content: t.body || '',
	type: t.data.type,
	date: t.data.date
})).sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title="Écrire une pensée | Les Pensées de Mina">
	<Header client:load />
	<main class="write-page">
		<div class="container section-padding">
			<div class="write-header animate-fade-in">
				<span class="subtitle">Laisser parler son cœur</span>
				<h1>Rédiger une <span class="text-gradient">Pensée</span></h1>
				<p>
					Prenez un moment pour vous. Posez vos mots, qu'ils soient légers comme une plume ou lourds comme un secret. 
				</p>
			</div>
			
			<Editor client:load initialThoughts={sortedThoughts} />
		</div>
	</main>
</Layout>

<style>
	.write-page {
		min-height: 100vh;
		background: linear-gradient(to bottom, var(--bg), #fff);
	}

	.write-header {
		text-align: center;
		max-width: 700px;
		margin: 0 auto 4rem;
	}

	.write-header h1 {
		font-size: 3.5rem;
		margin-bottom: 1.5rem;
	}

	.write-header p {
		color: var(--text-light);
		font-size: 1.1rem;
		line-height: 1.8;
	}

	.subtitle {
		display: block;
		font-family: var(--font-script);
		font-size: 1.8rem;
		color: var(--secondary);
		margin-bottom: 0.5rem;
	}
</style>
