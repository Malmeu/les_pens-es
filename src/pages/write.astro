---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import { WriteDashboard } from '../components/WriteDashboard';
import type { Thought } from '../components/Editor';
import type { BookChapter } from '../components/BookEditor';

// Charger les pensées
const thoughts = await getCollection('thoughts');
const sortedThoughts: Thought[] = thoughts.map((t: any) => ({
	id: t.id,
	title: t.data.title,
	content: t.body || '',
	type: t.data.type,
	date: t.data.date
})).sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Charger les chapitres de livres (gérer le cas où la collection est vide)
let sortedChapters: BookChapter[] = [];
try {
	const bookChapters = await getCollection('books');
	if (bookChapters) {
		sortedChapters = bookChapters.map((ch: any) => ({
			id: ch.id,
			title: ch.data.title,
			content: ch.body || '',
			bookId: ch.data.bookId,
			bookTitle: ch.data.bookTitle,
			bookDescription: ch.data.bookDescription || '',
			coverColor: ch.data.coverColor || 'pink',
			chapterNumber: ch.data.chapterNumber || 1,
			date: ch.data.date
		})).sort((a: any, b: any) => a.chapterNumber - b.chapterNumber);
	}
} catch (e) {
	console.log("La collection de livres est actuellement vide ou inexistante.");
}
---

<Layout title="Écrire | Les Pensées de Mina">
	<Header client:load />
	<main class="write-page">
		<div class="container section-padding">
			<div class="write-header animate-fade-in">
				<span class="subtitle">Laisser parler son cœur</span>
				<h1>Espace de <span class="text-gradient">Création</span></h1>
				<p>
					Rédigez une pensée passagère ou écrivez les pages de vos futurs livres. Vos mots méritent de briller.
				</p>
			</div>
			
			<WriteDashboard client:load initialThoughts={sortedThoughts} initialChapters={sortedChapters} />
		</div>
	</main>
</Layout>

<style>
	.write-page {
		min-height: 100vh;
		background: linear-gradient(to bottom, var(--bg), #fff);
	}

	.write-header {
		text-align: center;
		max-width: 700px;
		margin: 0 auto 4rem;
	}

	.write-header h1 {
		font-size: 3.5rem;
		margin-bottom: 1.5rem;
	}

	.write-header p {
		color: var(--text-light);
		font-size: 1.1rem;
		line-height: 1.8;
	}

	.subtitle {
		display: block;
		font-family: var(--font-script);
		font-size: 1.8rem;
		color: var(--secondary);
		margin-bottom: 0.5rem;
	}
</style>
